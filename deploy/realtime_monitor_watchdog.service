[Unit]
Description=OpenAgent Trade watchdog: рестарт монитора при молчащих маячках
# Установка: скопировать в /etc/systemd/system/, заменив __USER__ на своего.
After=realtime_monitor.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=%h/Документы/openagent_trade
ExecStart=%h/Документы/openagent_trade/.venv/bin/python scripts/watchdog.py
